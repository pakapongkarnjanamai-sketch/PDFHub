# Path the app is served under. "/" in development; the IIS application path in production.
VITE_PDFHUB_APP_BASE_PATH=/PDFHub/

# Optional. Defaults to <app base path>api — the API serves this app, so both share one origin.
# VITE_PDFHUB_API_BASE_URL=/PDFHub/api

# Development only: where the Vite dev server proxies /api and /pdf.
# PDFHUB_DEV_API_URL=http://localhost:5079
