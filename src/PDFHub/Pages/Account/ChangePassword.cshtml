@page "/account/password"
@model PDFHub.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "เปลี่ยนรหัสผ่าน";
}

<div class="auth">
    <form method="post" class="card auth-card">
        <h1>เปลี่ยนรหัสผ่าน</h1>
        @if (Model.Forced)
        {
            <div class="flash flash-warning">กรุณาตั้งรหัสผ่านใหม่ของคุณเองก่อนใช้งาน</div>
        }

        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div class="field">
            <label for="CurrentPassword">รหัสผ่านปัจจุบัน</label>
            <input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" autofocus required />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label for="NewPassword">รหัสผ่านใหม่</label>
            <input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="6" required />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label for="ConfirmPassword">ยืนยันรหัสผ่านใหม่</label>
            <input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">บันทึกรหัสผ่านใหม่</button>
    </form>
</div>
