@page
@model IndexModel
@{
    ViewData["Title"] = "รายการ Drawing";
    var f = Model.Filter;
    var canEdit = User.CanEdit();
    var offset = (f.Page - 1) * f.PageSize;
    string SortClass(string key) => f.SortKey == key ? (f.Desc ? "sort sorted desc" : "sort sorted asc") : "sort";
}

<div class="page-head">
    <div>
        <h1>รายการ Drawing</h1>
        <p class="muted">
            @if (f.IsFiltered)
            {
                <text>พบ <strong>@Model.Total.ToString("N0")</strong> รายการตามเงื่อนไข</text>
            }
            else
            {
                <text>ทั้งหมด <strong>@Model.Total.ToString("N0")</strong> รายการ</text>
            }
        </p>
    </div>
    <div class="actions">
        <a class="btn" asp-page="/Index" asp-page-handler="Export" asp-all-route-data="f.ToRoute(x => x.Page = 1)">
            @Ui.Icon("sheet") Export Excel
        </a>
        @if (canEdit)
        {
            <a class="btn btn-primary" asp-page="/Drawings/Edit">@Ui.Icon("plus") เพิ่ม Drawing</a>
        }
    </div>
</div>

<form method="get" class="card filters">
    <div class="field field-search">
        <label for="q">ค้นหา</label>
        <div class="input-icon">
            @Ui.Icon("search")
            <input id="q" name="q" type="search" value="@f.Q" autocomplete="off"
                   placeholder="PdfCode, Part Name, Drawing No., Material, Quo No., หมายเหตุ" />
        </div>
    </div>
    <div class="field">
        <label for="section">Section</label>
        <select id="section" name="section" data-autosubmit>
            <option value="">ทั้งหมด</option>
            @foreach (var s in Model.Sections)
            {
                <option value="@s.Code" selected="@(s.Code == f.Section)">@s.Code · @s.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="year">ปี</label>
        <select id="year" name="year" data-autosubmit>
            <option value="">ทั้งหมด</option>
            @foreach (var y in Model.Years)
            {
                <option value="@y" selected="@(y == f.Year)">@y</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="po">PO</label>
        <select id="po" name="po" data-autosubmit>
            <option value="">ทั้งหมด</option>
            <option value="yes" selected="@(f.Po == "yes")">มี PO แล้ว</option>
            <option value="no" selected="@(f.Po == "no")">ยังไม่มี PO</option>
        </select>
    </div>
    <div class="field">
        <label for="pdf">ไฟล์ PDF</label>
        <select id="pdf" name="pdf" data-autosubmit>
            <option value="">ทั้งหมด</option>
            <option value="has" selected="@(f.Pdf == "has")">มีไฟล์แล้ว</option>
            <option value="missing" selected="@(f.Pdf == "missing")">ยังไม่มีไฟล์</option>
        </select>
    </div>
    @if (f.Sort != DrawingFilter.DefaultSort || f.Dir != DrawingFilter.DefaultDir)
    {
        <input type="hidden" name="sort" value="@f.Sort" />
        <input type="hidden" name="dir" value="@f.Dir" />
    }
    <div class="field field-buttons">
        <button type="submit" class="btn btn-primary">ค้นหา</button>
        @if (f.IsFiltered)
        {
            <a class="btn btn-ghost" asp-page="/Index">ล้างตัวกรอง</a>
        }
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="card empty">
        @Ui.Icon("file", "icon-xl")
        @if (f.IsFiltered)
        {
            <h2>ไม่พบ Drawing ตามเงื่อนไข</h2>
            <p class="muted">ลองใช้คำค้นที่สั้นลง หรือ <a asp-page="/Index">ล้างตัวกรอง</a></p>
        }
        else
        {
            <h2>ยังไม่มีข้อมูล Drawing</h2>
            @if (canEdit)
            {
                <p class="muted">เริ่มจาก <a asp-page="/Drawings/Edit">เพิ่ม Drawing</a> ทีละรายการ หรือ <a asp-page="/Import/Index">นำเข้าจากไฟล์ Excel เดิม</a></p>
            }
        }
    </div>
}
else
{
    <div class="card table-wrap">
        <table class="grid">
            <thead>
                <tr>
                    <th class="num">No.</th>
                    <th><a class="@SortClass("code")" asp-page="/Index" asp-all-route-data='f.SortRoute("code")'>PdfCode</a></th>
                    <th><a class="@SortClass("section")" asp-page="/Index" asp-all-route-data='f.SortRoute("section")'>Section</a></th>
                    <th><a class="@SortClass("part")" asp-page="/Index" asp-all-route-data='f.SortRoute("part")'>Part Name</a></th>
                    <th><a class="@SortClass("drawing")" asp-page="/Index" asp-all-route-data='f.SortRoute("drawing")'>Drawing No.</a></th>
                    <th><a class="@SortClass("material")" asp-page="/Index" asp-all-route-data='f.SortRoute("material")'>Material</a></th>
                    <th class="num"><a class="@SortClass("price")" asp-page="/Index" asp-all-route-data='f.SortRoute("price")'>Price</a></th>
                    <th class="center">PDF</th>
                    <th><a class="@SortClass("date")" asp-page="/Index" asp-all-route-data='f.SortRoute("date")'>Input Date</a></th>
                    <th><a class="@SortClass("quo")" asp-page="/Index" asp-all-route-data='f.SortRoute("quo")'>Quo No.</a></th>
                    <th>Remark</th>
                    <th class="center"><a class="@SortClass("po")" asp-page="/Index" asp-all-route-data='f.SortRoute("po")'>PO</a></th>
                    @if (canEdit)
                    {
                        <th><span class="sr-only">แก้ไข</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var d = Model.Items[i];
                    <tr>
                        <td class="num muted">@(offset + i + 1)</td>
                        <td><a class="code" asp-page="/Drawings/Details" asp-route-code="@d.PdfCode">@d.PdfCode</a></td>
                        <td><span class="tag" title="@d.Section.Code">@d.Section.Name</span></td>
                        <td class="part">@d.PartName</td>
                        <td class="mono">@d.DrawingNo</td>
                        <td>@d.Material</td>
                        <td class="num">@Ui.Price(d.Price)</td>
                        <td class="center">
                            @if (d.PdfFileName is not null)
                            {
                                <a class="pdf-link" href="~/pdf/@(d.PdfCode).pdf" target="_blank" rel="noopener" title="เปิด @(d.PdfCode).pdf">@Ui.Icon("file") PDF</a>
                            }
                            else
                            {
                                <span class="missing" title="ยังไม่มีไฟล์ PDF">—</span>
                            }
                        </td>
                        <td class="nowrap">@Ui.Date(d.InputDate)</td>
                        <td>@d.QuoNo</td>
                        <td class="remark" title="@d.Remark">@d.Remark</td>
                        <td class="center">
                            @if (d.HasPo)
                            {
                                <span class="po-yes" title="มี PO แล้ว">@Ui.Icon("check")</span>
                            }
                        </td>
                        @if (canEdit)
                        {
                            <td class="row-actions">
                                <a class="icon-btn" asp-page="/Drawings/Edit" asp-route-id="@d.Id" title="แก้ไข @d.PdfCode">@Ui.Icon("edit")</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.PageCount > 1)
    {
        var first = Math.Max(1, f.Page - 3);
        var last = Math.Min(Model.PageCount, f.Page + 3);
        <nav class="pager" aria-label="หน้า">
            <span class="muted">แสดง @(offset + 1)–@(offset + Model.Items.Count) จาก @Model.Total.ToString("N0")</span>
            <div class="pager-links">
                @if (f.Page > 1)
                {
                    <a asp-page="/Index" asp-all-route-data="f.PageRoute(f.Page - 1)">‹ ก่อนหน้า</a>
                }
                @if (first > 1)
                {
                    <a asp-page="/Index" asp-all-route-data="f.PageRoute(1)">1</a>
                    @if (first > 2) { <span class="gap">…</span> }
                }
                @for (var p = first; p <= last; p++)
                {
                    if (p == f.Page)
                    {
                        <span class="current" aria-current="page">@p</span>
                    }
                    else
                    {
                        <a asp-page="/Index" asp-all-route-data="f.PageRoute(p)">@p</a>
                    }
                }
                @if (last < Model.PageCount)
                {
                    @if (last < Model.PageCount - 1) { <span class="gap">…</span> }
                    <a asp-page="/Index" asp-all-route-data="f.PageRoute(Model.PageCount)">@Model.PageCount</a>
                }
                @if (f.Page < Model.PageCount)
                {
                    <a asp-page="/Index" asp-all-route-data="f.PageRoute(f.Page + 1)">ถัดไป ›</a>
                }
            </div>
        </nav>
    }
}
