@page "/drawing/edit/{id:int?}"
@model PDFHub.Pages.Drawings.EditModel
@{
    var existing = Model.Existing;
    ViewData["Title"] = existing is null ? "เพิ่ม Drawing" : $"แก้ไข {existing.PdfCode}";
    var sectionMap = System.Text.Json.JsonSerializer.Serialize(
        Model.Sections.Where(s => s.IsActive).ToDictionary(s => s.Code, s => s.Name));
}

@if (existing is null)
{
    <a class="back-link" asp-page="/Index">@Ui.Icon("back") กลับไปรายการ</a>
}
else
{
    <a class="back-link" asp-page="/Drawings/Details" asp-route-code="@existing.PdfCode">@Ui.Icon("back") กลับไปหน้า @existing.PdfCode</a>
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        @if (existing is not null)
        {
            <p class="muted">แก้ไขล่าสุด @Ui.DateTime(existing.UpdatedAt)@(existing.UpdatedBy is null ? "" : " โดย " + existing.UpdatedBy)</p>
        }
    </div>
</div>

<form method="post" enctype="multipart/form-data" class="card form" id="drawing-form">
    <div asp-validation-summary="ModelOnly" class="flash flash-error"></div>

    <div class="form-grid">
        <div class="field field-code">
            <label asp-for="Input.PdfCode">PdfCode <span class="req">*</span></label>
            <input asp-for="Input.PdfCode" class="mono input-code" maxlength="8" autocomplete="off" required
                   placeholder="เช่น NB-06618" autofocus="@(existing is null)"
                   data-pdfcode data-sections="@sectionMap" data-id="@existing?.Id" />
            <div class="code-status" id="code-status" aria-live="polite"></div>
            <span asp-validation-for="Input.PdfCode" class="field-error"></span>
            <p class="hint">@PdfCodeRules.StickerHint</p>
        </div>

        <div class="field">
            <label>Section</label>
            <div class="readonly" id="section-name">@(existing?.Section.Name ?? "—")</div>
            <p class="hint">ระบบเลือกให้จาก 2 ตัวอักษรแรกของ PdfCode</p>
        </div>

        <div class="field span-2">
            <label asp-for="Input.PartName">Part Name <span class="req">*</span></label>
            <input asp-for="Input.PartName" required maxlength="200" />
            <span asp-validation-for="Input.PartName" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.DrawingNo">Drawing No.</label>
            <input asp-for="Input.DrawingNo" class="mono" maxlength="100" />
            <span asp-validation-for="Input.DrawingNo" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Material">Material</label>
            <input asp-for="Input.Material" list="materials" maxlength="100" autocomplete="off" />
            <datalist id="materials">
                @foreach (var m in Model.Materials)
                {
                    <option value="@m"></option>
                }
            </datalist>
            <span asp-validation-for="Input.Material" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Price">Price (บาท)</label>
            <input asp-for="Input.Price" type="text" inputmode="decimal" class="num" />
            <span asp-validation-for="Input.Price" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.InputDate">Input Date <span class="req">*</span></label>
            <input asp-for="Input.InputDate" type="date" required />
            <span asp-validation-for="Input.InputDate" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.QuoNo">Quotation No.</label>
            <input asp-for="Input.QuoNo" maxlength="50" />
            <span asp-validation-for="Input.QuoNo" class="field-error"></span>
        </div>

        <div class="field field-check">
            <label class="check">
                <input asp-for="Input.HasPo" />
                <span>Have a PO <span class="muted">(ได้รับใบสั่งซื้อแล้ว)</span></span>
            </label>
        </div>

        <div class="field span-2">
            <label asp-for="Input.Remark">Remark</label>
            <textarea asp-for="Input.Remark" rows="2" maxlength="1000"></textarea>
            <span asp-validation-for="Input.Remark" class="field-error"></span>
        </div>

        <div class="field span-2">
            <label for="PdfFile">ไฟล์ PDF</label>
            @if (existing?.PdfFileName is not null)
            {
                <div class="current-file">
                    @Ui.Icon("file")
                    <a href="~/pdf/@(existing.PdfCode).pdf" target="_blank" rel="noopener">@(existing.PdfCode).pdf</a>
                    <span class="muted">@Ui.FileSize(existing.PdfSize) · อัปโหลด @Ui.DateTime(existing.PdfUploadedAt)</span>
                </div>
            }
            <label class="dropzone" data-dropzone>
                <input type="file" id="PdfFile" name="PdfFile" accept="application/pdf,.pdf" />
                @Ui.Icon("upload", "icon-lg")
                <span data-dropzone-text>
                    @(existing?.PdfFileName is null ? "เลือกไฟล์ PDF หรือลากไฟล์มาวางที่นี่" : "เลือกไฟล์ใหม่เพื่อแทนที่ไฟล์เดิม (ไฟล์เดิมจะถูกเก็บสำรองไว้)")
                </span>
                <small class="muted">ขนาดไม่เกิน @Model.MaxPdfSizeMB MB</small>
            </label>
            <span asp-validation-for="PdfFile" class="field-error"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@Ui.Icon("check") บันทึก</button>
        @if (existing is null)
        {
            <button type="submit" name="then" value="next" class="btn" title="บันทึกแล้วเปิดฟอร์มใหม่ พร้อมรหัสถัดไปและวันที่เดิม">
                บันทึกและเพิ่มรายการถัดไป
            </button>
            <a class="btn btn-ghost" asp-page="/Index">ยกเลิก</a>
        }
        else
        {
            <a class="btn btn-ghost" asp-page="/Drawings/Details" asp-route-code="@existing.PdfCode">ยกเลิก</a>
        }
    </div>
</form>

@if (existing is not null && User.IsInRole(Roles.Admin))
{
    <form method="post" asp-page-handler="Delete" asp-route-id="@existing.Id" class="card danger-zone"
          data-confirm="ลบ @existing.PdfCode ออกจากระบบ? (ไฟล์ PDF จะถูกย้ายไปเก็บสำรอง ไม่ได้ลบทิ้ง)">
        <div>
            <strong>ลบ Drawing นี้</strong>
            <p class="muted">ข้อมูลจะถูกลบออกจากฐานข้อมูล ส่วนไฟล์ PDF จะถูกย้ายไปโฟลเดอร์ _archive</p>
        </div>
        <button type="submit" class="btn btn-danger">@Ui.Icon("trash") ลบ</button>
    </form>
}
