@page "/import"
@model PDFHub.Pages.Import.IndexModel
@{
    ViewData["Title"] = "นำเข้าข้อมูล";
    var r = Model.Result;
}

<div class="page-head">
    <div>
        <h1>นำเข้าข้อมูล</h1>
        <p class="muted">ย้ายข้อมูลจากไฟล์ Excel เดิม และอัปโหลดไฟล์ PDF ทีละหลายไฟล์ · ในระบบตอนนี้มี @Model.DrawingCount.ToString("N0") รายการ ยังไม่มี PDF @Model.MissingPdfCount.ToString("N0") รายการ</p>
    </div>
</div>

<div class="import-grid">
    <section class="card step">
        <div class="step-head">
            <span class="step-no">1</span>
            <div>
                <h2>นำเข้าข้อมูลจาก Excel</h2>
                <p class="muted">ใช้ไฟล์ .xlsx รูปแบบเดียวกับชีต NMB-2026 เดิม (มีหัวคอลัมน์ PdfCodeS, PartName, DrawingNo, MatS, Price, InputDate, QuoNo., Remark, Have a PO) หรือไฟล์ที่ Export จากระบบนี้ นำเข้าทุกชีตที่มีหัวคอลัมน์นี้</p>
            </div>
        </div>

        <form method="post" asp-page-handler="Excel" enctype="multipart/form-data" class="stack">
            <label class="dropzone" data-dropzone>
                <input type="file" name="ExcelFile" accept=".xlsx" required />
                @Ui.Icon("sheet", "icon-lg")
                <span data-dropzone-text>เลือกไฟล์ Excel (.xlsx)</span>
            </label>

            <fieldset class="options">
                <legend>ถ้า PdfCode มีอยู่ในระบบแล้ว</legend>
                <label class="check"><input type="radio" name="Mode" value="SkipExisting" checked="@(Model.Mode == ImportMode.SkipExisting)" /> ข้าม (เพิ่มเฉพาะรายการใหม่)</label>
                <label class="check"><input type="radio" name="Mode" value="UpdateExisting" checked="@(Model.Mode == ImportMode.UpdateExisting)" /> อัปเดตด้วยข้อมูลในไฟล์</label>
            </fieldset>

            <label class="check">
                <input type="checkbox" name="DryRun" value="true" checked="@Model.DryRun" />
                <span>ทดลองตรวจสอบก่อน <span class="muted">(ยังไม่บันทึกลงฐานข้อมูล)</span></span>
            </label>
            @* Unchecked boxes post nothing, which would leave DryRun at its default of true. *@
            <input type="hidden" name="DryRun" value="false" />

            <div><button type="submit" class="btn btn-primary">@Ui.Icon("upload") ตรวจสอบ / นำเข้า</button></div>
        </form>

        @if (Model.ExcelError is not null)
        {
            <div class="flash flash-error">@Model.ExcelError</div>
        }

        @if (r is not null)
        {
            <div class="result @(r.DryRun ? "result-dry" : "result-done")">
                <h3>@(r.DryRun ? "ผลการตรวจสอบ (ยังไม่บันทึก)" : "นำเข้าเรียบร้อย")</h3>
                @if (r.Sheets.Count > 0)
                {
                    <p class="muted">ชีต: @string.Join(", ", r.Sheets) · อ่าน @r.RowsRead แถว</p>
                }
                <div class="stats">
                    <div class="stat"><strong>@r.Added</strong><span>@(r.DryRun ? "จะเพิ่มใหม่" : "เพิ่มใหม่")</span></div>
                    <div class="stat"><strong>@r.Updated</strong><span>@(r.DryRun ? "จะอัปเดต" : "อัปเดต")</span></div>
                    <div class="stat"><strong>@r.Skipped</strong><span>ข้าม (มีอยู่แล้ว)</span></div>
                    <div class="stat @(r.Errors.Count > 0 ? "stat-bad" : "")"><strong>@r.Errors.Count</strong><span>ผิดพลาด</span></div>
                </div>

                @if (r.Errors.Count > 0 || r.Warnings.Count > 0)
                {
                    <div class="table-wrap issues">
                        <table class="grid compact">
                            <thead><tr><th>ชีต</th><th class="num">แถว</th><th>PdfCode</th><th>รายละเอียด</th></tr></thead>
                            <tbody>
                                @foreach (var e in r.Errors)
                                {
                                    <tr class="row-error"><td>@e.Sheet</td><td class="num">@e.Row</td><td class="mono">@e.Code</td><td>@e.Message</td></tr>
                                }
                                @foreach (var w in r.Warnings)
                                {
                                    <tr class="row-warn"><td>@w.Sheet</td><td class="num">@w.Row</td><td class="mono">@w.Code</td><td>@w.Message</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="muted small">แถวที่ผิดพลาดจะไม่ถูกนำเข้า แถวที่เป็นคำเตือนนำเข้าได้</p>
                }

                @if (r.DryRun && r.Added + r.Updated > 0)
                {
                    <p><strong>ถ้าผลถูกต้อง</strong> ให้เลือกไฟล์เดิมอีกครั้ง เอาเครื่องหมาย "ทดลองตรวจสอบก่อน" ออก แล้วกดนำเข้า</p>
                }
            </div>
        }
    </section>

    <section class="card step">
        <div class="step-head">
            <span class="step-no">2</span>
            <div>
                <h2>อัปโหลดไฟล์ PDF หลายไฟล์</h2>
                <p class="muted">ชื่อไฟล์ต้องเป็น PdfCode เช่น <span class="mono">NB-06618.pdf</span> (แบบเดียวกับโฟลเดอร์ DrawingNMB2026 เดิม) ระบบจะจับคู่กับข้อมูลให้เอง ต้องมีข้อมูล Drawing ในระบบก่อน</p>
            </div>
        </div>

        <form id="pdf-uploader" method="post" asp-page-handler="Pdf" class="stack" data-max-mb="@Model.MaxPdfSizeMB">
            <div class="pick-row">
                <label class="btn">
                    @Ui.Icon("file") เลือกไฟล์ PDF
                    <input type="file" accept=".pdf,application/pdf" multiple hidden data-pick />
                </label>
                <label class="btn">
                    @Ui.Icon("folder") เลือกทั้งโฟลเดอร์
                    <input type="file" webkitdirectory multiple hidden data-pick />
                </label>
            </div>
            <label class="check">
                <input type="checkbox" name="overwrite" value="true" data-overwrite />
                <span>แทนที่ไฟล์ที่มีอยู่แล้ว <span class="muted">(ไฟล์เดิมจะถูกเก็บสำรองใน _archive)</span></span>
            </label>

            <div class="upload-status" hidden data-status>
                <div class="progress"><div class="progress-bar" data-bar></div></div>
                <div class="stats">
                    <div class="stat"><strong data-count="ok">0</strong><span>อัปโหลดแล้ว</span></div>
                    <div class="stat"><strong data-count="skip">0</strong><span>ข้าม</span></div>
                    <div class="stat stat-bad"><strong data-count="error">0</strong><span>ผิดพลาด</span></div>
                    <div class="stat"><strong data-count="left">0</strong><span>รอคิว</span></div>
                </div>
                <label class="check small"><input type="checkbox" data-only-problems /> แสดงเฉพาะที่ข้าม/ผิดพลาด</label>
                <div class="table-wrap issues">
                    <table class="grid compact">
                        <thead><tr><th>ไฟล์</th><th>ผล</th></tr></thead>
                        <tbody data-log></tbody>
                    </table>
                </div>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <script src="~/js/pdf-uploader.js" asp-append-version="true"></script>
}
