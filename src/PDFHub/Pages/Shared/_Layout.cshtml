@{
    var page = ViewContext.RouteData.Values["page"] as string ?? "";
    string Active(params string[] prefixes) => prefixes.Any(p => page.StartsWith(p)) ? "active" : "";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? title + " · " : "")PDFHub</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Icons" />
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="~/">
                <img src="~/favicon.svg" alt="" width="28" height="28" />
                <span class="brand-name">PDFHub</span>
                <span class="brand-sub">Drawing Database</span>
            </a>
            <nav class="nav">
                <a class="@Active("/Index", "/Drawings")" asp-page="/Index">รายการ Drawing</a>
                @if (User.CanEdit())
                {
                    <a class="@Active("/Import")" asp-page="/Import/Index">นำเข้าข้อมูล</a>
                }
                @if (User.IsInRole(Roles.Admin))
                {
                    <a class="@Active("/Admin/Sections")" asp-page="/Admin/Sections">Section</a>
                    <a class="@Active("/Admin/Users")" asp-page="/Admin/Users">ผู้ใช้งาน</a>
                }
            </nav>
            <div class="account">
                @if (signedIn)
                {
                    <details class="menu">
                        <summary>@Ui.Icon("user") <span>@User.DisplayName()</span></summary>
                        <div class="menu-panel">
                            <div class="menu-head">
                                <strong>@User.Identity!.Name</strong>
                                <span>@Roles.Label(User.IsInRole(Roles.Admin) ? Roles.Admin : User.IsInRole(Roles.Editor) ? Roles.Editor : Roles.Viewer)</span>
                            </div>
                            <a asp-page="/Account/ChangePassword">เปลี่ยนรหัสผ่าน</a>
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit">ออกจากระบบ</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a class="btn btn-sm btn-on-dark" asp-page="/Account/Login" asp-route-returnUrl="@returnUrl">เข้าสู่ระบบ</a>
                }
            </div>
        </div>
    </header>

    <main class="container">
        @if (TempData["Flash"] is string flash)
        {
            <div class="flash flash-@(TempData["FlashKind"] ?? "success")" role="status">@flash</div>
        }
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
