<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\PDFHub.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- IIS rejects bodies over 30 MB before the app sees them; 110 MB = MaxPdfSizeMB (100) + form overhead. -->
          <requestLimits maxAllowedContentLength="115343360" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
