# Build output
bin/
obj/
publish/
artifacts/
TestResults/
node_modules/
src/PDFHub.Web/dist/
# The React build is copied here by scripts/Deploy-PDFHub.ps1; it is not source. The folder itself
# must exist, or ASP.NET Core's static web assets fail at startup.
src/PDFHub.Api/wwwroot/*
!src/PDFHub.Api/wwwroot/.gitkeep

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo

# Local environment
.env
.env.local
.env.*.local

# Runtime data: database, uploaded PDFs, backups
App_Data/
*.db
*.db-shm
*.db-wal

# Customer data (prices, drawing numbers) — keep it out of the public repository
Doc/*.xlsx
Doc/*.xlsm
Doc/*.pdf
